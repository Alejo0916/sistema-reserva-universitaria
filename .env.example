# --- Entorno de SIGREA -------------------------------------------------
# Copie este archivo a .env y ajuste los valores. Los valores marcados como
# "cambiar en produccion" DEBEN cambiarse antes de desplegar.

# Puerto y host del servidor HTTP
PUERTO=3000
HOST=0.0.0.0

# Ruta del archivo SQLite. Use ":memory:" para una base efimera de pruebas.
DATABASE_URL=./data/sigrea.db

# Secreto de firma de los tokens JWT (obligatorio, minimo 32 caracteres)
JWT_SECRET=cambiar-en-produccion-por-un-secreto-aleatorio-de-al-menos-32-caracteres
JWT_EXPIRES_IN=2h

# Horario de funcionamiento por defecto de los espacios (HH:MM)
ESPACIO_HORARIO_APERTURA=08:00
ESPACIO_HORARIO_CIERRE=22:00

# Anticipacion minima (en horas) para solicitar una reserva
ANTICIPACION_MINIMA_HORAS=2

# Duracion minima (en minutos) de una reserva
DURACION_MINIMA_MINUTOS=15

# Maximo de horas consecutivas que una persona puede tener reservadas en una
# misma fecha (regla de la institucion). Se convierte a minutos al cargar.
LIMITE_HORAS_CONSECUTIVAS=4

# Origen permitido para CORS (la UI servida por el propio Express no lo necesita)
CORS_ORIGIN=http://localhost:3000

# Nivel de detalle de los logs: debug | info | warn | error
LOG_LEVEL=info
